# No Vite environment variables are required for a standard local build.
# Do not put provider keys, OAuth credentials, webhook secrets, access tokens,
# downloaded credential files, or private account data in Vite environment values.

# Optional cloud-hosted subscription router endpoint.
# Use an HTTPS Cloud Run or gateway URL here. These are public service URLs, not secrets.
# Set the mode to cloud for official product builds so the app never prompts users
# to install the local subscription runtime when the cloud URL is missing.
# VITE_GILBERT_NINE_ROUTER_MODE=cloud
# VITE_GILBERT_REQUIRE_CLOUD_SUBSCRIPTIONS=true
# VITE_GILBERT_NINE_ROUTER_DASHBOARD_URL=https://gilbert-nine-router-gateway-4bwbtno2aq-uc.a.run.app
# VITE_GILBERT_NINE_ROUTER_BASE_URL=https://gilbert-nine-router-gateway-4bwbtno2aq-uc.a.run.app/v1

# Optional Stripe Billing gateway endpoint.
# Public Cloud Run URL only; Stripe secret keys and webhook secrets belong in Secret Manager.
# VITE_GILBERT_BILLING_API_URL=https://gilbert-billing-gateway-811485840625.us-central1.run.app

# Optional cloud-hosted connected-app endpoints.
# Public Cloud Run URLs only; OAuth client secrets and bot tokens belong in Secret Manager.
# Each connector is deployed as its own Cloud Run service so GitHub, Google, and Discord fail independently.
# VITE_GILBERT_GITHUB_CONNECTOR_URL=https://gilbert-github-connector-4bwbtno2aq-uc.a.run.app
# VITE_GILBERT_GOOGLE_CONNECTOR_URL=https://gilbert-google-connector-4bwbtno2aq-uc.a.run.app
# VITE_GILBERT_DISCORD_CONNECTOR_URL=https://gilbert-discord-connector-4bwbtno2aq-uc.a.run.app
