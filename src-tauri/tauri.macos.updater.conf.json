{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Gilbert Codex",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "maximized": false,
        "fullscreen": false,
        "preventOverflow": true,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "acceptFirstMouse": true,
        "tabbingIdentifier": "gilbert-codex"
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
