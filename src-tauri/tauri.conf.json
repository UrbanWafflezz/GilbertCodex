{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gilbert Codex",
  "version": "0.8.5",
  "identifier": "com.gilbert.codex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run dictation:model && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gilbert Codex",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "maximized": false,
        "fullscreen": false,
        "preventOverflow": true,
        "visible": false,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* http://0.0.0.0:* ws://localhost:* ws://127.0.0.1:*",
        "font-src": "'self' data:",
        "frame-src": "http: https:",
        "img-src": "'self' asset: http://asset.localhost blob: data: http: https:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 Gilbert Codex Contributors",
    "createUpdaterArtifacts": false,
    "homepage": "https://gilbertcodex.com",
    "targets": "nsis",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "publisher": "Gilbert Codex Contributors",
    "shortDescription": "GUI-first local desktop agent workspace.",
    "longDescription": "Gilbert Codex is a local-first desktop agent workspace with cloud subscriptions, managed 9Router model routing, multi-provider model streaming, planning mode, source-backed context, project-scoped state, connected apps, and signed over-the-air updates.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../plugins/*": "plugins/",
      "../resources/models/whisper/*": "models/whisper/"
    },
    "windows": {
      "allowDowngrades": false,
      "minimumWebview2Version": "110.0.1531.0",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "compression": "lzma",
        "displayLanguageSelector": false,
        "headerImage": "windows/installer-header.bmp",
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "sidebarImage": "windows/installer-sidebar.bmp",
        "startMenuFolder": "Gilbert Codex",
        "uninstallerHeaderImage": "windows/installer-header.bmp",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4NDkwMDJFQjVGNjU2ODQKUldTRVZ2YTFMZ0JKV0FKdWM4Y3g4cVY2SWxtaUtYUVIvN1FXWVhpaTdodzhIeFNxcjJ2UnhzTHUK",
      "endpoints": [
        "https://firebasestorage.googleapis.com/v0/b/gilbertcodex-40428.firebasestorage.app/o/releases%2Flatest.json?alt=media"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
